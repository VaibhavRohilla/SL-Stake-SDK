{
  "name": "@fnx/stake-sdk",
  "version": "0.1.0",
  "description": "Standalone typed Stake Engine live and replay protocol client",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "FNX",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests examples",
    "test": "vitest run tests/client.test.ts tests/protocol.test.ts",
    "test:integration": "vitest run tests/http.integration.test.ts",
    "test:browser": "npm run build && playwright test",
    "test:consumer": "npm run build && node scripts/consumer.mjs",
    "pack:verify": "npm run test:consumer",
    "doctor": "npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "22.19.18",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}

{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true, "noImplicitOverride": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["src", "tests", "examples", "playwright.config.ts"]
}
